{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "composite": false
  },
  "include": ["src/frontend/**/*"],
  "exclude": ["dist", "node_modules", "src-tauri", "src/main", "src/preload", "src/renderer"]
}
