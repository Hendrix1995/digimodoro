{
  "name": "@digimodoro/app",
  "version": "0.4.5",
  "private": true,
  "description": "Tauri shell for DigiModoro",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "clean": "rm -rf dist",
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "dev": "pnpm --filter @digimodoro/core build && tauri dev",
    "build": "pnpm --filter @digimodoro/core build && tauri build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'app — no tests yet'"
  },
  "dependencies": {
    "@digimodoro/core": "workspace:*",
    "@digimodoro/data": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-notification": "^2.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "typescript": "^5.5.0",
    "vite": "^8.0.14"
  }
}
